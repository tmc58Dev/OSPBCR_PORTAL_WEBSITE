# Build output
bin/
obj/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs
*.log
*.err.log
*.out.log

# Temporary files
*.cache
*.tmp
*.temp

# IDE settings
.vscode/
.idea/

# Publish output
publish/

# Windows system files
Thumbs.db
Desktop.ini
