@model IReadOnlyList<NewsCard>
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = "News Cards";
}
<header class="cms-page-header cms-page-header-actions">
    <div>
        <span class="cms-eyebrow">Public home page</span>
        <h1>News Cards</h1>
        <p>Create a new multilingual card or update any existing card.</p>
    </div>
    <a class="cms-button cms-button-primary" asp-action="CreateNews">Create News Card</a>
</header>
@if (Model.Count == 0)
{
    <section class="cms-empty">
        <h2>No News Cards yet</h2>
        <p>Create the first English, Hindi, and Odia update for the home-page slider.</p>
        <a class="cms-button cms-button-primary" asp-action="CreateNews">Create News Card</a>
    </section>
}
else
{
    <div class="cms-content-grid">
    @foreach (var card in Model)
    {
        var english = card.Translations.GetValueOrDefault("en");
        var primaryImagePath = card.ImagePaths.FirstOrDefault() ?? english?.ImagePath;
        var imagePaths = card.ImagePaths.Count > 0
            ? card.ImagePaths.ToArray()
            : !string.IsNullOrWhiteSpace(primaryImagePath)
                ? new[] { primaryImagePath! }
                : Array.Empty<string>();
        var publishDate = english?.PublishDate;
        <article class="cms-content-card cms-news-card" data-cms-news-card data-active-image="0">
            <div class="cms-news-card-media">
                @if (imagePaths.Length > 0)
                {
                    <div class="cms-news-card-gallery" data-cms-news-image-track>
                        @for (var imageIndex = 0; imageIndex < imagePaths.Length; imageIndex++)
                        {
                            <img src="@imagePaths[imageIndex]"
                                 alt="@(imageIndex == 0 ? english?.Title ?? "News Card image" : $"News Card image {imageIndex + 1}")"
                                 loading="lazy"
                                 decoding="async"
                                 aria-hidden="@(imageIndex == 0 ? "false" : "true")"
                                 data-cms-news-card-image />
                        }
                    </div>
                }
                else
                {
                    <div class="cms-news-card-placeholder" aria-hidden="true">OSPBCR</div>
                }
                <span class="cms-news-card-language">English</span>
                @if (imagePaths.Length > 1)
                {
                    <button class="cms-news-image-control cms-news-image-previous" type="button"
                            aria-label="Previous photo" title="Previous photo" data-cms-news-image-previous>
                        <span aria-hidden="true">&lsaquo;</span>
                    </button>
                    <button class="cms-news-image-control cms-news-image-next" type="button"
                            aria-label="Next photo" title="Next photo" data-cms-news-image-next>
                        <span aria-hidden="true">&rsaquo;</span>
                    </button>
                    <span class="cms-news-card-photo-count" data-cms-news-image-position>1 / @imagePaths.Length</span>
                    @if (imagePaths.Length <= 10)
                    {
                        <div class="cms-news-card-image-dots" aria-hidden="true">
                            @for (var imageIndex = 0; imageIndex < imagePaths.Length; imageIndex++)
                            {
                                <span class="@(imageIndex == 0 ? "is-active" : null)" data-cms-news-image-dot></span>
                            }
                        </div>
                    }
                }
            </div>
            <div class="cms-content-card-body cms-news-card-content">
                <h2>@(english?.Title ?? "Untitled card")</h2>
                <div class="cms-card-meta cms-news-card-meta">
                    <span class="cms-status @(card.Status == "Published" ? "is-published" : "is-draft")">@card.Status</span>
                    <time datetime="@(publishDate?.ToString("yyyy-MM-dd"))">@(publishDate?.ToString("dd/MM/yyyy") ?? "—")</time>
                </div>
                <div class="content-inline-actions">
                    <a class="cms-button cms-button-primary" asp-action="EditNews" asp-route-id="@card.Id">Update card</a>
                    <form asp-action="DeleteNews" asp-route-id="@card.Id" method="post" data-confirm="Delete this multilingual News Card and its uploaded images?">
                        <button class="cms-button cms-button-danger" type="submit">Delete</button>
                    </form>
                </div>
            </div>
        </article>
    }
    </div>
}
@section Scripts {
    <script src="~/assets/js/pages/cms-news-cards.js" asp-append-version="true"></script>
    <script>document.querySelectorAll("[data-confirm]").forEach(form => form.addEventListener("submit", event => { if (!confirm(form.dataset.confirm)) event.preventDefault(); }));</script>
}
