@model IReadOnlyList<CancerBurdenRecord>
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = "Cancer Burden PDFs";
}
<header class="cms-page-header cms-page-header-actions">
    <div>
        <span class="cms-eyebrow">Public Cancer Burden page</span>
        <h1>Cancer Burden PDFs</h1>
        <p>Manage exactly one factsheet PDF per district, along with its descriptions and preview image.</p>
    </div>
    <a class="cms-button cms-button-primary" asp-action="CreateCancerBurden">Add or Replace PDF</a>
</header>
<div class="cms-content-grid">
@foreach (var record in Model)
{
    <article class="cms-content-card">
        <img src="@Url.ApplicationContent(record.PreviewPath)" alt="@record.District cancer burden PDF preview" />
        <div class="cms-content-card-body">
            <span class="cms-badge">@record.District</span>
            <div class="cms-rich-text-title" role="heading" aria-level="2" data-rich-text-display>@record.Title</div>
            <div class="cms-card-rich-text" data-rich-text-display>@record.Description</div>
            <div class="content-inline-actions">
                <a class="cms-button cms-button-secondary cms-button-small" href="@Url.ApplicationContent(record.PdfPath)" target="_blank" rel="noopener">View PDF</a>
                <a class="cms-button cms-button-secondary cms-button-small" asp-action="EditCancerBurden" asp-route-id="@record.Id">Update</a>
                <form asp-action="DeleteCancerBurden" asp-route-id="@record.Id" method="post" data-confirm="Delete this cancer burden record and its uploaded files?">
                    <button class="cms-button cms-button-danger cms-button-small" type="submit">Delete</button>
                </form>
            </div>
        </div>
    </article>
}
</div>
@section Scripts {
    <script>document.querySelectorAll("[data-confirm]").forEach(form => form.addEventListener("submit", event => { if (!confirm(form.dataset.confirm)) event.preventDefault(); }));</script>
}
