<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | OSPBCR Content Management</title>
    <link rel="stylesheet" href="~/assets/css/cms.css" asp-append-version="true" />
</head>
<body class="cms-body">
    <header class="cms-header">
        <div class="cms-brand-group">
            <div class="cms-brand" role="img" aria-label="OSPBCR Content Management System">
                <span class="cms-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 48 48" focusable="false">
                        <rect x="11" y="8" width="26" height="32" rx="6"></rect>
                        <path d="M17 17h14M17 23h14"></path>
                        <path d="m17 31 4 4 10-10"></path>
                    </svg>
                </span>
                <span><strong>OSPBCR CMS</strong><small>Content Management</small></span>
            </div>
            <a class="cms-public-site-link" href="~/home.html">View Public Website</a>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="cms-nav" aria-label="Content management">
                <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Admin" asp-action="News">News Cards</a>
                <a asp-controller="Admin" asp-action="Training">Training PDFs</a>
                <a asp-controller="Admin" asp-action="CancerBurden">Cancer Burden PDFs</a>
                <a asp-controller="Admin" asp-action="OdishaCirculars">Odisha State Circulars</a>
                @if (User.IsInRole(CmsRoles.Admin))
                {
                    <a asp-controller="Admin" asp-action="Users">Users</a>
                }
            </nav>
            <div class="cms-user">
                <span><strong>@User.Identity.Name</strong><small>@(User.IsInRole(CmsRoles.Admin) ? "Admin" : "User")</small></span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="cms-link-button" type="submit">Sign out</button>
                </form>
            </div>
        }
    </header>
    <main class="cms-main">
        @if (TempData["Success"] is string success)
        {
            <div class="cms-alert cms-alert-success" role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="cms-alert cms-alert-error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="cms-footer">
        <span>Odisha State Population-Based Cancer Registry</span>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/assets/js/core/rich-text.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
